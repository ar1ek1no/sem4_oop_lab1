    {
      "name": "01 Аутентификация",
      "item": [
        {
          "name": "Вход клиента (успех)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"client1\", \"password\": \"client1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('есть токен', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.collectionVariables.set('clientToken', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Вход: неверный пароль",
          "request": {
            "method": "POST",
            "header": [
