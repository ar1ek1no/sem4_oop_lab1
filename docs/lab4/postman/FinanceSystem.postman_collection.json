              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"client1\", \"password\": \"wrong\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('сообщение об ошибке', () => pm.expect(pm.response.json().error).to.include('неверный'));"
                ]
